{
  "name": "@zhangbo9005/easy-vps",
  "version": "0.2.1",
  "description": "在自己电脑的浏览器里，给自己的 VPS 一键安装 Geto 面板，并能查看、停止、重启、卸载。SSH 密码只在你自己的电脑上使用。",
  "keywords": [
    "vps",
    "ssh",
    "installer",
    "panel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arras9005/evps.git"
  },
  "homepage": "https://github.com/Arras9005/evps#readme",
  "bugs": {
    "url": "https://github.com/Arras9005/evps/issues"
  },
  "type": "module",
  "bin": {
    "easy-vps": "dist/server/main.js",
    "evps": "dist/server/main.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "remote",
    "promo.json",
    "w.ps1",
    "m.sh",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "node --experimental-strip-types server/main.ts",
    "dev:web": "vite",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build:server": "node dev/bundle-server.mjs",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/server/main.js",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "node dev/prepublish.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-vue": "6.0.10",
    "rolldown": "1.2.19",
    "ssh2": "1.17.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  }
}
